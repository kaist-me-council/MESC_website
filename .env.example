# MESC 학생회 웹사이트 환경 변수 예시
# 실제 값은 .env.local (로컬) 또는 Vercel 대시보드 Settings → Environment Variables 에 입력
# .env.local 은 절대 커밋하지 않습니다.

# ── 데이터베이스 ─────────────────────────────────────────────
# 비어 있으면 로컬 SQLite (prisma/dev.db) 로 fallback
DATABASE_URL=""
# Turso(libSQL) 사용 시 필수 — 없으면 프로덕션 전 페이지가 500
TURSO_AUTH_TOKEN=""

# ── 관리자 로그인 ────────────────────────────────────────────
# ADMIN_USERNAME/ADMIN_PASSWORD 둘 다 반드시 설정해야 로그인이 동작한다
# (미설정 시 로그인은 전부 거부됨 — 빈 자격증명 우회 방지)
ADMIN_USERNAME=""
ADMIN_PASSWORD=""
AUTH_SECRET=""
NEXTAUTH_SECRET=""
NEXTAUTH_URL=""

# ── 익명 게시판 식별 salt (프로덕션 권장) ───────────────────────
# 미설정이어도 게시판은 동작하나, 추측 가능한 fallback salt 가 쓰여 익명성이
# 약화된다(서버 로그에 경고 1회 출력). 가능한 한 설정 권장.
# 길고 무작위한 값으로 설정: openssl rand -hex 32
ANON_SALT=""

# ── Vercel Blob (사진/파일 업로드) ──────────────────────────
BLOB_READ_WRITE_TOKEN=""

# ── Google Sheets (회비/예산) ────────────────────────────────
GOOGLE_FEE_CSV_URL=""

# ── Google Calendar (학과 일정) ─────────────────────────────
NEXT_PUBLIC_ICAL_URL=""

# ── Google Drive 행사 사진 동기화 ────────────────────────────
# 1) 공개 폴더 일괄 가져오기용 API 키 (선택 — 기존 Drive 폴더 import 기능에만 사용)
GOOGLE_DRIVE_API_KEY=""

# 2) OAuth 2.0 (필수 — 사이트가 사용자 본인 Drive 에 폴더/사진 자동 생성)
# Google Cloud Console → APIs & Services → Credentials → Create OAuth client ID
#   - Application type: Web application
#   - Authorized redirect URIs:
#       https://mesc-website.vercel.app/api/auth/drive/callback
#       http://localhost:3000/api/auth/drive/callback   (로컬 테스트 시)
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
# 옵션 — production 도메인이 mesc-website.vercel.app 가 아니거나 커스텀 도메인 사용 시 명시
GOOGLE_OAUTH_REDIRECT_URI=""

# ── 사이트 URL (sitemap·OG 공유 카드) ────────────────────────
# 미설정 시 https://mesc-website.vercel.app 로 폴백
NEXT_PUBLIC_SITE_URL=""

# ── 과비 확인 시트 컬럼 (선택) ───────────────────────────────
# 미설정 시 헤더에서 "학번"/"id"/"번호" 를 자동 감지
FEE_STUDENT_ID_COLUMN=""

# ── 주간 백업 크론 (/api/cron/backup, 매주 월 05:00 KST) ──────
# ⚠️ 단순 인증 토큰이 아니다. 백업 파일 암호화 키(=sha256 of this)로도 쓰인다.
#    값을 바꾸면 기존 백업(.json.enc)을 영영 복호화할 수 없다.
#    인수인계로 교체해야 한다면 이전 값을 반드시 따로 보관할 것.
#    복호화: node scripts/decrypt-backup.mjs <파일> <CRON_SECRET>
# 미설정 시 크론이 401 로 조용히 실패 → 백업과 개인정보 파기가 함께 멈춘다.
CRON_SECRET=""

# ── 웹푸시 (VAPID) ───────────────────────────────────────────
# 생성: npx web-push generate-vapid-keys
# ⚠️ 키를 바꾸면 기존 구독자의 알림이 전부 무효가 된다.
# 미설정 시 빌드는 성공하고 알림 기능만 조용히 죽는다.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT=""
